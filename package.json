{
  "name": "ai-lang-monorepo",
  "version": "0.1.1",
  "private": true,
  "description": "A natural-language programming language for AI to write software in. Compiles to Java, TypeScript, Python, Go and Rust, plus Docker, Kubernetes, Terraform and AWS.",
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc --build",
    "clean": "tsc --build --clean",
    "typecheck": "tsc --build --force",
    "test": "vitest run",
    "test:watch": "vitest",
    "release:dry": "npm run build && npm publish --workspaces --dry-run",
    "ail": "node --experimental-strip-types packages/cli/src/bin.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "homepage": "https://github.com/dscanavall11/ai-lang#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dscanavall11/ai-lang.git"
  },
  "bugs": {
    "url": "https://github.com/dscanavall11/ai-lang/issues"
  },
  "author": "dscanavall11",
  "keywords": [
    "programming-language",
    "compiler",
    "domain-driven-design",
    "ddd",
    "hexagonal-architecture",
    "code-generation",
    "infrastructure-as-code",
    "natural-language",
    "ai",
    "llm"
  ]
}
