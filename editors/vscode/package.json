{
  "name": "ai-lang",
  "displayName": "AI-Lang",
  "description": "Syntax highlighting and editing support for AI-Lang, a natural-language programming language that compiles to Java, TypeScript, Python and Go.",
  "version": "0.1.0",
  "publisher": "dscanavall11",
  "license": "Apache-2.0",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "keywords": [
    "ail",
    "ai-lang",
    "natural language",
    "domain-driven design",
    "hexagonal architecture"
  ],
  "homepage": "https://github.com/dscanavall11/ai-lang#readme",
  "bugs": {
    "url": "https://github.com/dscanavall11/ai-lang/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dscanavall11/ai-lang.git",
    "directory": "editors/vscode"
  },
  "contributes": {
    "languages": [
      {
        "id": "ail",
        "aliases": [
          "AI-Lang",
          "ail"
        ],
        "extensions": [
          ".ail"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "ail",
        "scopeName": "source.ail",
        "path": "./syntaxes/ail.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "ail",
        "path": "./snippets/ail.json"
      }
    ],
    "configurationDefaults": {
      "[ail]": {
        "editor.insertSpaces": true,
        "editor.tabSize": 2,
        "editor.detectIndentation": false,
        "editor.wordWrap": "on",
        "editor.renderWhitespace": "boundary",
        "editor.guides.indentation": true,
        "editor.rulers": [
          100
        ]
      }
    }
  }
}
