{
  "name": "hadl",
  "displayName": "HADL",
  "description": "Syntax highlighting and editing support for HADL, a natural-language programming language that compiles to Java, TypeScript, Python and Go.",
  "version": "0.3.0",
  "publisher": "dscanavall11",
  "license": "Apache-2.0",
  "engines": {
    "vscode": "^1.75.0"
  },
  "main": "./client.js",
  "activationEvents": [
    "onLanguage:hadl"
  ],
  "categories": [
    "Programming Languages",
    "Snippets",
    "Linters",
    "Formatters"
  ],
  "keywords": [
    "hadl",
    "hadl",
    "natural language",
    "domain-driven design",
    "hexagonal architecture"
  ],
  "homepage": "https://github.com/dscanavall11/hadl#readme",
  "bugs": {
    "url": "https://github.com/dscanavall11/hadl/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dscanavall11/hadl.git",
    "directory": "editors/vscode"
  },
  "contributes": {
    "languages": [
      {
        "id": "hadl",
        "aliases": [
          "HADL",
          "hadl"
        ],
        "extensions": [
          ".hadl"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "hadl",
        "scopeName": "source.hadl",
        "path": "./syntaxes/hadl.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "hadl",
        "path": "./snippets/hadl.json"
      }
    ],
    "configuration": {
      "title": "HADL",
      "properties": {
        "hadl.server.command": {
          "type": "string",
          "default": "",
          "description": "Command that runs the HADL compiler. Empty means: the workspace's own @haic/cli, then this checkout, then \"haic\" on PATH."
        },
        "hadl.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Log the traffic between the editor and the language server."
        }
      }
    },
    "configurationDefaults": {
      "[hadl]": {
        "editor.insertSpaces": true,
        "editor.tabSize": 2,
        "editor.detectIndentation": false,
        "editor.wordWrap": "on",
        "editor.renderWhitespace": "boundary",
        "editor.guides.indentation": true,
        "editor.rulers": [
          100
        ],
        "editor.formatOnSave": true
      }
    }
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}
